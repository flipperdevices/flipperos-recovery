config BR2_PACKAGE_DUPEREMOVE
	bool "duperemove"
	depends on BR2_USE_MMU # glib2, sqlite
	depends on BR2_USE_WCHAR # glib2, libbsd
	depends on BR2_TOOLCHAIN_HAS_THREADS # pthread, glib2, libbsd
	depends on !BR2_STATIC_LIBS # libbsd
	select BR2_PACKAGE_SQLITE # hashfile database
	select BR2_PACKAGE_LIBGLIB2
	select BR2_PACKAGE_LIBBSD
	select BR2_PACKAGE_XXHASH # libxxhash (unbundled since 0.15)
	help
	  duperemove finds duplicate extents across a set of files and
	  submits them to the kernel for deduplication (btrfs / xfs
	  FIDEDUPERANGE), reclaiming space without altering file contents.
	  Pairs with compsize (which reports on-disk compression).

	  https://github.com/markfasheh/duperemove

comment "duperemove needs a toolchain w/ threads, wchar, dynamic libs"
	depends on BR2_USE_MMU
	depends on !BR2_TOOLCHAIN_HAS_THREADS || !BR2_USE_WCHAR || BR2_STATIC_LIBS
