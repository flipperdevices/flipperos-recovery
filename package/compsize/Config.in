config BR2_PACKAGE_COMPSIZE
	bool "compsize"
	depends on BR2_USE_MMU # btrfs-progs
	depends on BR2_TOOLCHAIN_HAS_THREADS # btrfs-progs
	select BR2_PACKAGE_BTRFS_PROGS # <btrfs/ioctl.h>, <btrfs/ctree.h>
	help
	  compsize takes a list of files (or directories) on a btrfs
	  filesystem and reports their used compressed and uncompressed
	  sizes plus the effective compression ratio - i.e. how much space
	  btrfs transparent compression actually saved.

	  https://github.com/kilobyte/compsize

comment "compsize needs a toolchain w/ threads"
	depends on BR2_USE_MMU
	depends on !BR2_TOOLCHAIN_HAS_THREADS
