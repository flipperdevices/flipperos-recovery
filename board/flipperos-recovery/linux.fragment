# Kernel config fragment for flipperos-recovery.
#
# This repo builds ONLY the initramfs. The kernel is built in
# flipperdevices/flipper-linux-kernel. Merge these options into that kernel's
# RK3576 config (they are what the recovery initramfs relies on to boot and to
# do its job). Drop this file into the kernel repo's configs/ and merge with
# scripts/kconfig/merge_config.sh, or copy the lines into the defconfig.

# --- Initramfs: the recovery cpio is loaded by U-Boot (BLS initrd) and unpacked
#     by the kernel. We ship zstd only (rootfs.cpio.zst), so enable just RD_ZSTD. ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y

# --- Boot speed: compress the kernel Image with zstd (fast decompress, smaller
#     Image to read from UFS). Pick exactly one KERNEL_* compressor. ---
CONFIG_KERNEL_ZSTD=y
# CONFIG_KERNEL_GZIP is not set

# devtmpfs must exist: the pre-init /init mounts it before exec'ing systemd.
CONFIG_DEVTMPFS=y

# --- Storage recovery must reach the internal device. Build the UFS + MMC/eMMC
#     stacks in (=y), not as modules: the initramfs ships no kernel modules, so
#     any driver needed to touch storage has to be built into the kernel. ---
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_ROCKCHIP=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y

# --- Filesystems the recovery tools create/repair (ext4, vfat/ESP). ---
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# Filesystems recovery may need to mount/repair. Keep ext4/vfat/btrfs (main-OS
# root is btrfs) + iso9660 + overlayfs, plus exFAT and macOS (HFS/HFS+). For NTFS
# use the legacy read-only CONFIG_NTFS_FS driver (pinned here, not just inherited
# from the base config): NTFS3 (read-write) is left out on purpose because it
# refuses to build in (a dependency forbids =y) and this kernel is monolithic.
CONFIG_BTRFS_FS=y
CONFIG_EXFAT_FS=y
# CONFIG_NTFS3_FS is not set
CONFIG_NTFS_FS=y
CONFIG_HFSPLUS_FS=y
CONFIG_HFS_FS=y
# CONFIG_SQUASHFS is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_UDF_FS is not set

# --- Networking for SSH/DHCP recovery over Ethernet or USB gadget. Enable the
#     appropriate USB device-controller + gadget (RNDIS/ECM) for your board. ---
CONFIG_INET=y
CONFIG_USB_GADGET=y
# Use ONLY configfs gadgets. The legacy gadget drivers (g_ether, g_mass_storage,
# g_serial, g_multi, cdc_composite) auto-bind the UDC at boot and would make it
# "busy" so recovery-usb-gadget can't build its own composite gadget. Disable
# them; keep configfs + the function backends (NCM for USB networking).
# CONFIG_USB_ETH is not set
# CONFIG_USB_ETH_RNDIS is not set
# CONFIG_USB_MASS_STORAGE is not set
# CONFIG_USB_G_SERIAL is not set
# CONFIG_USB_CDC_COMPOSITE is not set
# CONFIG_USB_G_MULTI is not set
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y

# --- Trim subsystems recovery never uses (the all-modules-builtin flip would
#     otherwise pull them all in). Display/DRM and Bluetooth are intentionally
#     KEPT (on-screen console; MT7921 combo BT). ---
# No camera/video capture (drops the whole V4L/media tree + the cameras fragment).
# CONFIG_MEDIA_SUPPORT is not set
# Flipper One audio: simple-audio-card "On-board Analog NAU8822" on SAI2 (I2S).
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP=y
CONFIG_SND_SOC_ROCKCHIP_SAI=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SOC_NAU8822=y
# No firewall/NAT - recovery doesn't route (drops the router 'nft' fragment).
# CONFIG_NETFILTER is not set
# ...but keep L2 bridging: br0 = WiFi-AP + end1 + flipusb0.
CONFIG_BRIDGE=y
# No CAN bus on recovery.
# CONFIG_CAN is not set

# --- WiFi: MediaTek MT7921U (USB dongle, 0e8d:7961). Built in (=y) because the
#     initramfs ships no modules. CONFIG_MT7921U selects the mt76 stack; listed
#     explicitly so a fragment-merge is unambiguous. Needs USB host (xHCI) for
#     the internal USB bus the NIC sits on. wireless-regdb is shipped in the
#     initramfs; keep CRDA off and let cfg80211 load regulatory.db directly. ---
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
# The MT7921U hangs off the board's ONBOARD USB hubs; this driver powers/resets
# them. It is =m in the base config, so a module-less initramfs leaves the
# internal USB bus (and thus WiFi) dead. Must be built in.
CONFIG_USB_ONBOARD_DEV=y
# cfg80211 can only be built-in if rfkill is too (depends on RFKILL || !RFKILL);
# the base config has RFKILL=m, which would otherwise cascade the whole wireless
# stack (cfg80211/mac80211/mt76/mt7921u) back to =m. Pin it =y.
CONFIG_RFKILL=y
CONFIG_CFG80211=y
# CONFIG_CFG80211_CRDA_SUPPORT is not set
CONFIG_MAC80211=y
CONFIG_WLAN=y
# This board's WiFi is MediaTek MT7921U ONLY. Keep the MediaTek vendor stack and
# disable every other WiFi vendor the base "wifi" fragment / all-builtin config
# would otherwise pull in (we ship no firmware for them either). Trims the Image.
CONFIG_WLAN_VENDOR_MEDIATEK=y
# CONFIG_WLAN_VENDOR_ADMTEK is not set
# CONFIG_WLAN_VENDOR_ATH is not set
# CONFIG_WLAN_VENDOR_ATMEL is not set
# CONFIG_WLAN_VENDOR_BROADCOM is not set
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_INTERSIL is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
# CONFIG_WLAN_VENDOR_MICROCHIP is not set
# CONFIG_WLAN_VENDOR_PURELIFI is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set
# CONFIG_WLAN_VENDOR_RALINK is not set
# CONFIG_WLAN_VENDOR_REALTEK is not set
# CONFIG_WLAN_VENDOR_RSI is not set
# CONFIG_WLAN_VENDOR_SILABS is not set
# CONFIG_WLAN_VENDOR_ST is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_WLAN_VENDOR_ZYDAS is not set
CONFIG_MT76_CORE=y
CONFIG_MT76_USB=y
CONFIG_MT76_CONNAC_LIB=y
CONFIG_MT792x_LIB=y
CONFIG_MT792x_USB=y
CONFIG_MT7921_COMMON=y
CONFIG_MT7921U=y

# --- Monolithic housekeeping: symbols that refuse to build in (=y) and so cannot
#     ship in a module-less initramfs. Disabled explicitly. ---
# Crypto self-test/benchmark; dev/debug only, nothing in recovery uses it.
# CONFIG_CRYPTO_BENCHMARK is not set
